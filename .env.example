PORT=4001
NODE_ENV=development
# Reverse-proxy hop count in front of this process (0 = direct exposure, e.g. local dev)
TRUST_PROXY=0

MONGO_URI=mongodb://localhost:27017/ecom_connector
MONGO_MAX_POOL_SIZE=5
MONGO_MIN_POOL_SIZE=1
REDIS_URL=redis://localhost:6379

# 32-byte key, hex-encoded (64 hex chars) — AES-256-GCM, encrypts stored refresh tokens
MASTER_ENCRYPTION_KEY=

# Signs the OAuth `state` param (CSRF protection). Deliberately a SEPARATE secret from
# MASTER_ENCRYPTION_KEY — different purpose, so rotating one never forces rotating the other.
OAUTH_STATE_SECRET=

# NOTE: client credentials (Speedecom, and every other client company) live in the
# Client collection in Mongo, not here — there can be more than one, so they're not
# env vars. See models/Client.js.

# Connector's own app-level registration with each marketplace (shared across every client's tenants)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_OAUTH_REDIRECT_URI=
# SP-API's "application_id" (Seller Central authorization workflow) — distinct from the
# LWA client_id above, which is only used for token exchange.
AMAZON_APPLICATION_ID=
AMAZON_AUTHORIZATION_BASE_URL=https://sellercentral.amazon.com/apps/authorize/consent
# true while the app is still Draft/unreviewed — appends version=beta, which Amazon requires
# to test an unpublished app's real consent flow at all (otherwise it 404s as MD1000).
# Flip to false once Amazon approves/publishes the app.
AMAZON_DRAFT_MODE=false
AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
# Region-specific SP-API host — na / eu / fe. Pick the one matching AWS_REGION below.
AMAZON_SP_API_BASE_URL=https://sellingpartnerapi-na.amazon.com

# SP-API requires AWS SigV4-signed requests on top of the LWA token above — a separate
# credential layer. This is the long-lived IAM user registered on the SP-API app; it's
# used only to assume AWS_ROLE_ARN and sign requests with the resulting temporary
# credentials (adapters/amazon/awsAuth.js) — never used directly against SP-API itself.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ROLE_ARN=
AWS_REGION=us-east-1
# Optional — defaults to the global STS endpoint if unset. Override for a regional one.
AWS_STS_ENDPOINT=

FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
FLIPKART_OAUTH_REDIRECT_URI=
FLIPKART_AUTHORIZATION_BASE_URL=https://api.flipkart.net/oauth-service/oauth/authorize
FLIPKART_TOKEN_URL=https://api.flipkart.net/oauth-service/oauth/token
FLIPKART_API_BASE_URL=https://api.flipkart.net
